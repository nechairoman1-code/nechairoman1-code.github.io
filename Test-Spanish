</div>

<script>
/* PASS = порог правильных из 10 в блоке. 7 = стандарт (70%). 8 = строже. */
const PASS = 7;
const PER_BLOCK = 10;

/* ====================================================================
   TELEGRAM-БОТ (отчёт преподавателю)
   1. Вставь токен бота (от @BotFather) и свой chat_id ниже.
   2. Узнать chat_id: напиши своему боту, открой
      https://api.telegram.org/bot<ТОКЕН>/getUpdates и найди "chat":{"id":...}
   3. TG_BOT_LINK — необязательно, для кнопки-ссылки на бота.
   ВНИМАНИЕ: токен будет виден в исходном коде страницы на GitHub Pages.
   Если это нежелательно — можно сделать через защищённый релей, скажи.
   ==================================================================== */
const TG_BOT_TOKEN = "8752655946:AAGS13Hd33IYI8IiUKv34bYy1kgKJKr0mzs";
const TG_CHAT_ID   = "6587576780";
const TG_BOT_LINK  = "https://t.me/ВСТАВЬ_ЮЗЕРНЕЙМ_БОТА";
const TG_CONFIGURED = !TG_BOT_TOKEN.includes("ВСТАВЬ") && !TG_CHAT_ID.includes("ВСТАВЬ");

function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}

async function sendToTelegram(text){
  const url=`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`;
  const r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify({chat_id:TG_CHAT_ID,text,parse_mode:"HTML",disable_web_page_preview:true})});
  if(!r.ok) throw new Error("HTTP "+r.status);
  return r.json();
}

function buildReport(name,res,counts,wrong){
  const c=COPY[res.key];
  const when=new Date().toLocaleString('ru-RU');
  let t=`📝 <b>Тест: ${COPY.title}</b>\n`;
  t+=`👤 ${name?esc(name):'без имени'}\n`;
  t+=`🕒 ${when}\n\n`;
  t+=`🎯 <b>Уровень: ${res.level}</b> — ${esc(c.group)}\n`;
  t+=`📊 A1 ${counts.A1}/${PER_BLOCK} · A2 ${counts.A2}/${PER_BLOCK} · B1 ${counts.B1}/${PER_BLOCK}\n`;
  if(wrong.length===0){ t+=`\n✅ Ошибок нет.`; }
  else{
    t+=`\n❌ <b>Ошибки (${wrong.length}):</b>\n`;
    wrong.forEach((w,k)=>{
      t+=`${k+1}. [${w.item.lvl}] ${esc(w.item.q)}\n   ✗ ${esc(w.item.opts[w.chosen])} → ✓ ${esc(w.item.opts[w.item.a])}\n`;
    });
  }
  return t;
}

let LAST_REPORT="";
function sendReport(){
  const st=document.getElementById('tgStatus');
  const resend=document.getElementById('tgResend');
  const link=document.getElementById('tgLink');
  if(TG_BOT_LINK && !TG_BOT_LINK.includes('ВСТАВЬ')){link.href=TG_BOT_LINK;link.style.display='';}
  if(!TG_CONFIGURED){st.textContent='';return;}
  st.textContent='Отправляю результат преподавателю…';st.className='tg-status';
  resend.style.display='none';
  sendToTelegram(LAST_REPORT)
    .then(()=>{st.textContent='✓ Результат отправлен преподавателю';st.className='tg-status ok';})
    .catch(()=>{st.textContent='Не удалось отправить автоматически. Попробуй ещё раз.';
                st.className='tg-status err';resend.style.display='';});
}

const QUESTIONS = [
  // ---------- A1 ----------
  {lvl:'A1', q:'Yo ___ profesor.', opts:['soy','eres','es'], a:0},
  {lvl:'A1', q:'Nosotros ___ español.', opts:['habla','hablamos','hablan'], a:1},
  {lvl:'A1', q:'La casa es ___.', opts:['blanco','blanca','blancos'], a:1},
  {lvl:'A1', q:'___ un libro en la mesa.', opts:['Hay','Es','Está'], a:0},
  {lvl:'A1', q:'Yo ___ dos hermanos.', opts:['tiene','tengo','tienes'], a:1},
  {lvl:'A1', q:'Me ___ el café.', opts:['gusta','gustan','gusto'], a:0},
  {lvl:'A1', q:'Madrid ___ en España.', opts:['es','está','hay'], a:1},
  {lvl:'A1', q:'Esta es ___ casa.', opts:['mi','mí','me'], a:0},
  {lvl:'A1', q:'___ problema es difícil.', opts:['El','La','Los'], a:0},
  {lvl:'A1', q:'¿___ te llamas?', opts:['Qué','Cómo','Dónde'], a:1},

  // ---------- A2 ----------
  {lvl:'A2', q:'Ayer ___ una película.', opts:['veo','vi','visto'], a:1},
  {lvl:'A2', q:'El año pasado ___ a México por primera vez.', opts:['voy','fui','iba'], a:1},
  {lvl:'A2', q:'Me ___ mucho las series.', opts:['gusta','gustan','gusto'], a:1},
  {lvl:'A2', q:'Mañana ___ estudiar.', opts:['voy a','voy','iba a'], a:0},
  {lvl:'A2', q:'Me ___ a las siete.', opts:['levanto','levanta','levantas'], a:0},
  {lvl:'A2', q:'Ana es ___ alta que María.', opts:['más','muy','mucho'], a:0},
  {lvl:'A2', q:'¿El libro? ___ tengo aquí.', opts:['Le','Lo','La'], a:1},
  {lvl:'A2', q:'Ahora ___ comiendo.', opts:['soy','estoy','está'], a:1},
  {lvl:'A2', q:'___ estudiar para el examen.', opts:['Tengo que','Tengo','Hay'], a:0},
  {lvl:'A2', q:'Cuando era niño, ___ en el parque todos los días.', opts:['jugué','jugaba','juego'], a:1},

  // ---------- B1 ----------
  {lvl:'B1', q:'Si tuviera dinero, ___ por todo el mundo.', opts:['viajo','viajaría','viajaba'], a:1},
  {lvl:'B1', q:'Me ___ viajar a Japón algún día.', opts:['gusta','gustaría','gustó'], a:1},
  {lvl:'B1', q:'Quiero que ___ a mi fiesta.', opts:['vienes','vengas','venir'], a:1},
  {lvl:'B1', q:'Es importante que ___ todos los días.', opts:['estudias','estudies','estudiar'], a:1},
  {lvl:'B1', q:'___ las ocho cuando llegué.', opts:['Fueron','Eran','Son'], a:1},
  {lvl:'B1', q:'No ___ ruido, por favor.', opts:['haces','hagas','haz'], a:1},
  {lvl:'B1', q:'¿El regalo? Ya ___ di a Juan.', opts:['le lo','se lo','lo le'], a:1},
  {lvl:'B1', q:'Estudio mucho ___ aprobar el examen.', opts:['por','para','de'], a:1},
  {lvl:'B1', q:'Aquí ___ español.', opts:['habla','se habla','es hablado'], a:1},
  {lvl:'B1', q:'Cuando llegué, la película ya ___.', opts:['empezó','ha empezado','había empezado'], a:2},
];

const COPY = {
  subject:'испанского',
  title:'Испанский (A1–B1)',
  A1:{group:'Группа A1 (с нуля / начинающие)',
      reason:'Базовый уровень A1 ещё не закрыт — есть пробелы в основах. Это нормальная стартовая точка.'},
  A1zero:{group:'Группа A1 — с нуля (A0)',
      reason:'Испанский практически с нуля. Идеально начинать с самого начала.'},
  A2:{group:'Группа A2',
      reason:'Уровень A1 освоен уверенно. Готов учиться на A2.'},
  B1:{group:'Группа B1',
      reason:'Уровни A1 и A2 освоены. Готов учиться на B1.'},
  B1plus:{group:'Уровень B1 и выше',
      reason:'Все три блока пройдены — студент уже владеет B1 и приближается к B2. Это потолок текущих групп.'}
};

/* ==================== Движок ==================== */
const form=document.getElementById('quiz');
QUESTIONS.forEach((item,i)=>{
  const qtext=item.q.replace('___','<span class="gap"></span>');
  const hint=item.hint?`<span class="q-hint">${item.hint}</span>`:'';
  const opts=item.opts.map((o,j)=>`
    <label class="opt" data-q="${i}" data-o="${j}">
      <input type="radio" name="q${i}" value="${j}"> <span>${o}</span>
    </label>`).join('');
  const el=document.createElement('div');el.className='q';
  el.innerHTML=`<div class="q-top"><span class="q-num">${i+1}</span>
    <span class="q-text">${qtext}${hint}</span></div><div class="opts">${opts}</div>`;
  form.appendChild(el);
});

const progressEl=document.getElementById('progress');
form.addEventListener('change',e=>{
  if(e.target.name){
    const lab=e.target.closest('.opt');
    lab.parentNode.querySelectorAll('.opt').forEach(o=>o.classList.remove('sel'));
    lab.classList.add('sel');
  }
  const answered=new Set([...form.querySelectorAll('input:checked')].map(i=>i.name)).size;
  progressEl.textContent=`Отвечено: ${answered} / ${QUESTIONS.length}`;
});

let left=20*60;const timerEl=document.getElementById('timer');let ticking=true;
const tick=setInterval(()=>{
  if(!ticking)return;
  left--;
  if(left<=0){left=0;ticking=false;timerEl.textContent='Время вышло';timerEl.classList.add('amber');return;}
  const m=String(Math.floor(left/60)).padStart(2,'0');
  const s=String(left%60).padStart(2,'0');
  timerEl.textContent=`${m}:${s}`;
  if(left<=120)timerEl.classList.add('amber');
},1000);

function place(c){
  if(c.A1 < PASS) return c.A1 < 4 ? {level:'A1',key:'A1zero',gate:0}:{level:'A1',key:'A1',gate:0};
  if(c.A2 < PASS) return {level:'A2',key:'A2',gate:1};
  if(c.B1 < PASS) return {level:'B1',key:'B1',gate:2};
  return {level:'B1+',key:'B1plus',gate:3};
}

document.getElementById('submit').addEventListener('click',()=>{
  const answered=new Set([...form.querySelectorAll('input:checked')].map(i=>i.name)).size;
  if(answered<QUESTIONS.length){
    document.getElementById('miss').textContent=`Отвечено ${answered} из ${QUESTIONS.length}. Ответь на все вопросы — это нужно для точного результата.`;
    const firstEmpty=QUESTIONS.findIndex((_,i)=>!form.querySelector(`input[name="q${i}"]:checked`));
    if(firstEmpty>=0)form.querySelectorAll('.q')[firstEmpty].scrollIntoView({behavior:'smooth',block:'center'});
    return;
  }
  document.getElementById('miss').textContent='';
  ticking=false;clearInterval(tick);

  const counts={A1:0,A2:0,B1:0};const wrong=[];
  QUESTIONS.forEach((item,i)=>{
    const val=+form.querySelector(`input[name="q${i}"]:checked`).value;
    if(val===item.a)counts[item.lvl]++;
    else wrong.push({i,item,chosen:val});
  });

  const res=place(counts);const c=COPY[res.key];
  document.getElementById('vLevel').textContent=res.level;
  document.getElementById('vGroup').textContent=c.group;
  document.getElementById('vReason').textContent=c.reason;

  const meter=document.getElementById('meter');meter.innerHTML='';
  ['A1','A2','B1'].forEach(lv=>{
    const sc=counts[lv];const passed=sc>=PASS;
    const seg=document.createElement('div');seg.className='seg'+(passed?' pass':'');
    seg.innerHTML=`<div class="nm">${lv}</div><div class="sc">${sc}/${PER_BLOCK}</div>
      <div class="track"><div class="fill" style="width:${sc/PER_BLOCK*100}%"></div></div>
      <div class="tag">${passed?'освоен':'не закрыт'}</div>`;
    meter.appendChild(seg);
  });

  let note=`Порог уровня: ${PASS} из ${PER_BLOCK}. `;
  const borderline=['A1','A2','B1'].find(lv=>counts[lv]===PASS-1);
  if(borderline){
    note+=`Блок <b>${borderline}</b> на грани (${counts[borderline]}/${PER_BLOCK}) — стоит уточнить вживую на пробном.`;
  }else{
    note+='Оценка идёт по нижнему незакрытому блоку: даже сильный результат выше не поднимает уровень, пока есть пробел снизу.';
  }
  document.getElementById('vNote').innerHTML=note;

  const rev=document.getElementById('review');rev.innerHTML='';
  if(wrong.length===0){rev.innerHTML='<div class="rev-item">Все ответы верные.</div>';}
  else wrong.forEach(w=>{
    const d=document.createElement('div');d.className='rev-item';
    d.innerHTML=`<span class="rev-lvl">${w.item.lvl}</span>
      <span class="rq">${w.item.q}</span><br>
      <span class="rw">✗ ${w.item.opts[w.chosen]}</span> &nbsp;→&nbsp;
      <span class="ra">✓ ${w.item.opts[w.item.a]}</span>`;
    rev.appendChild(d);
  });
  document.querySelector('#reviewBox summary').textContent=`Разбор ошибок (${wrong.length}) — для преподавателя`;

  document.getElementById('submit').style.display='none';
  const r=document.getElementById('result');r.classList.add('show');
  r.scrollIntoView({behavior:'smooth',block:'start'});
  try{ym(109141141,'reachGoal','test_es_done',{level:res.level});}catch(e){}

  // --- Отчёт преподавателю в Telegram ---
  const stuName=(document.getElementById('stuName').value||'').trim();
  LAST_REPORT=buildReport(stuName,res,counts,wrong);
  sendReport();
});

document.getElementById('tgResend').addEventListener('click',sendReport);
document.getElementById('restart').addEventListener('click',()=>location.reload());
</script>
</body>
</html>
