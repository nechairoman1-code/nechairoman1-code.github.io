  .note{font-size:14px;color:var(--muted);margin-top:14px;text-align:center}
  .note b{color:var(--warn)}

  details{margin-top:18px;border:1px solid var(--line);border-radius:12px;background:var(--card)}
  summary{cursor:pointer;padding:14px 16px;font-weight:700;font-size:15px;list-style:none}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"  ▾";color:var(--muted)}
  .rev{padding:0 16px 14px}
  .rev-item{padding:11px 0;border-top:1px solid var(--line);font-size:14px}
  .rev-item .rq{font-weight:600}
  .rev-item .ra{color:var(--ok);font-weight:600}
  .rev-item .rw{color:#c0392b}
  .rev-lvl{display:inline-block;font-size:11px;font-weight:700;color:var(--accent);
    background:var(--accent-soft);border-radius:6px;padding:1px 7px;margin-right:6px}

  .restart{display:block;margin:22px auto 0;background:none;border:1px solid var(--line);color:var(--ink);
    border-radius:10px;padding:11px 20px;font-family:'Mulish';font-weight:600;font-size:15px;cursor:pointer}
  .restart:hover{border-color:var(--accent);color:var(--accent)}

  .namebox{background:var(--card);border:1px solid var(--line);border-radius:12px;
    padding:12px 14px;margin-bottom:16px}
  .namebox label{font-size:13px;font-weight:700;color:var(--ink)}
  .namebox label span{color:var(--muted);font-weight:500}
  .namebox input{width:100%;margin-top:7px;border:1px solid var(--line);border-radius:9px;
    padding:10px 12px;font-family:'Mulish';font-size:15px;color:var(--ink);background:var(--paper)}
  .namebox input:focus{outline:none;border-color:var(--accent)}
  .tg{margin-top:16px;text-align:center}
  .tg-status{display:block;font-size:14px;font-weight:600;color:var(--muted);min-height:18px}
  .tg-status.ok{color:var(--ok)}
  .tg-status.err{color:var(--warn)}
  .tg-btn{margin-top:10px;background:none;border:1px solid var(--line);color:var(--ink);
    border-radius:10px;padding:10px 16px;font-family:'Mulish';font-weight:600;font-size:14px;cursor:pointer}
  .tg-btn:hover{border-color:var(--accent);color:var(--accent)}
  .tg-link{display:inline-block;margin-top:10px;color:var(--accent);font-weight:700;font-size:14px;text-decoration:none}
  .tg-link:hover{text-decoration:underline}

  @media(max-width:480px){h1{font-size:25px}.verdict .level{font-size:50px}.meter{gap:7px}.seg{padding:11px 6px}}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
