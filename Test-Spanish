<style>
  :root{
    --ink:#241d22;
    --paper:#faf7f3;
    --card:#ffffff;
    --muted:#6e6660;
    --line:#ece4d9;
    --accent:#c8472b;        /* испанский = тёплый терракот */
    --accent-soft:#fbeae5;
    --ok:#1f9d72;
    --ok-soft:#e6f5ef;
    --warn:#c9821a;
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{background:var(--paper);color:var(--ink);font-family:'Mulish',system-ui,sans-serif;
    line-height:1.55;-webkit-font-smoothing:antialiased}
  .wrap{max-width:680px;margin:0 auto;padding:28px 20px 80px}

  header{margin-bottom:22px}
  .eyebrow{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700}
  h1{font-family:'Playfair Display',serif;font-weight:700;font-size:30px;margin:6px 0 8px;line-height:1.15}
  .lead{color:var(--muted);font-size:15px;margin:0}

  .bar{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:12px;
    background:rgba(250,247,243,.92);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);
    padding:10px 0;margin-bottom:18px}
  .progress-txt{font-size:13px;color:var(--muted);font-weight:600}
  .timer{font-variant-numeric:tabular-nums;font-weight:700;font-size:15px;
    background:var(--card);border:1px solid var(--line);border-radius:999px;padding:5px 13px}
  .timer.amber{color:var(--warn);border-color:var(--warn)}

  .q{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 18px 8px;margin-bottom:14px}
  .q-top{display:flex;align-items:baseline;gap:10px;margin-bottom:12px}
  .q-num{font-family:'Playfair Display',serif;font-weight:700;color:var(--accent);font-size:18px;min-width:30px}
  .q-text{font-size:17px;font-weight:600}
  .q-text .gap{border-bottom:2px solid var(--accent);padding:0 16px}
  .q-hint{color:var(--muted);font-weight:500;font-size:14px;display:block;margin-top:2px}
  .opts{display:flex;flex-direction:column;gap:8px;margin-top:4px}
  .opt{display:flex;align-items:center;gap:11px;border:1px solid var(--line);border-radius:10px;
    padding:11px 13px;cursor:pointer;font-size:16px;transition:border-color .12s,background .12s}
  .opt:hover{border-color:var(--accent)}
  .opt input{accent-color:var(--accent);width:17px;height:17px;flex:none;margin:0}
  .opt.sel{border-color:var(--accent);background:var(--accent-soft)}

  .submit{width:100%;border:none;border-radius:12px;background:var(--ink);color:#fff;
    font-family:'Mulish';font-weight:700;font-size:16px;padding:15px;cursor:pointer;margin-top:6px;transition:opacity .15s}
  .submit:hover{opacity:.9}
  .miss{text-align:center;color:var(--warn);font-size:14px;font-weight:600;margin-top:10px;min-height:18px}

  .result{display:none}
  .result.show{display:block;animation:fade .4s ease}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .verdict{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px 22px;text-align:center}
  .verdict .label{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700}
  .verdict .level{font-family:'Playfair Display',serif;font-size:62px;font-weight:700;line-height:1;margin:6px 0 4px;color:var(--accent)}
  .verdict .group{font-size:16px;font-weight:600}
  .verdict .reason{color:var(--muted);font-size:15px;margin-top:10px}

  .meter{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin:20px 0 4px}
  .seg{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:13px 12px;text-align:center}
  .seg .nm{font-family:'Playfair Display',serif;font-weight:700;font-size:18px}
  .seg .sc{font-size:22px;font-weight:700;font-variant-numeric:tabular-nums;margin:3px 0}
  .seg .track{height:7px;background:var(--line);border-radius:99px;overflow:hidden;margin-top:6px}
  .seg .fill{height:100%;width:0;border-radius:99px;background:var(--muted);transition:width .6s ease}
  .seg.pass{border-color:var(--ok);background:var(--ok-soft)}
  .seg.pass .fill{background:var(--ok)}
  .seg.pass .nm{color:var(--ok)}
  .seg .tag{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-top:7px;color:var(--muted)}
